KIMI_API_KEY=
# 国内平台默认地址。国际站可改为 https://api.moonshot.ai/v1
KIMI_BASE_URL=https://api.moonshot.cn/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 语音对话：MiniMax 国内平台 ASR + TTS
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.cn
MINIMAX_ASR_MODEL=asr-1.0
MINIMAX_TTS_MODEL=speech-2.8-turbo
SESSION_SECRET=zhaka-dev-session-secret-change-me
# 上 HTTPS 后设为 true
# COOKIE_SECURE=true
MORA_DATA_DIR=./data
# 硬件网关与 ESP32 共用。留空则网关拒绝连接。不要提交真实值。
DEVICE_TOKEN=
DEVICE_GATEWAY_PORT=8787
# 硬件从哪份档案复制 Persona、模型和记忆策略。默认 profile-default
# DEVICE_TEMPLATE_PROFILE_ID=profile-default
# 云服务器没有 dns-sd 时设为 0，关掉局域网 mDNS
# DEVICE_GATEWAY_MDNS=0
# 硬件对话 Router 等待上限（毫秒）。留空=等完整网络 Router（含能量）；0=跳过网络只用规则；正数=超时后规则兜底
# DEVICE_ROUTER_BUDGET_MS=
# 设为 1 时把每句硬件录音存到 data/device-audio/，用于查截断和误触发
DEVICE_SAVE_AUDIO=0
